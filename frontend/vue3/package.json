{
  "name": "@nexgus/fsb-vue",
  "version": "0.2.0",
  "description": "Vue 3 component package for the fsbrowser file system browser",
  "license": "MIT",
  "type": "module",
  "main": "./dist/fsb-vue.js",
  "module": "./dist/fsb-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fsb-vue.js"
    },
    "./style.css": "./dist/fsb-vue.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "dependencies": {
    "@nexgus/fsb-core": "file:../core"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.6.3",
    "vite": "^6.3.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.12"
  }
}
